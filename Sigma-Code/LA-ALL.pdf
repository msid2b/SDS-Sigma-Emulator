BT
12.0 562.560975609756 Td
(     557         09 00198           HELPTEXT QTEXTC ' '     )Tj ET
BT
12.0 548.4146341463414 Td
(     558         09 00199            QTEXTC 'LA: List all files with name and account matching pattern'     )Tj ET
BT
12.0 534.2682926829268 Td
(     559         09 001A8            QTEXTC 'Version date: AUGUST\, 2026'     )Tj ET
BT
12.0 520.1219512195122 Td
(     560         09 001AF            QTEXTC 'LA filepattern\[.accountpattern\]\[\,selection-options\]'     )Tj ET
BT
12.0 505.9756097560976 Td
(     561         09 001BC            QTEXTC ' '     )Tj ET
BT
12.0 491.8292682926829 Td
(     562         09 001BD            QTEXTC 'One file is listed one per line in a manner similar to the '     )Tj ET
BT
12.0 477.6829268292683 Td
(     563         09 001CC            QTEXTC 'output of the PCL L\(A\) command.  If the DETAIL option is '     )Tj ET
BT
12.0 463.5365853658536 Td
(     564         09 001DB            QTEXTC 'supplied\, then the information for each file is split into '     )Tj ET
BT
12.0 449.390243902439 Td
(     565         09 001EA            QTEXTC 'multiple lines.'     )Tj ET
BT
12.0 435.2439024390244 Td
(     566         09 001EE            QTEXTC ' '     )Tj ET
BT
12.0 421.0975609756098 Td
(     567         09 001EF            QTEXTC 'File and account patterns can contain wildcard characters:'     )Tj ET
BT
12.0 406.9512195121951 Td
(     568         09 001FE            QTEXTC '   *   matches any sequence of characters'     )Tj ET
BT
12.0 392.8048780487805 Td
(     569         09 00209            QTEXTC '   ?   matches any single character'     )Tj ET
BT
12.0 378.6585365853658 Td
(     570         09 00212            QTEXTC '   +   matches any single digit'     )Tj ET
BT
12.0 364.5121951219512 Td
(     571         09 0021A            QTEXTC '   \\   naturalizes the following character'     )Tj ET
BT
12.0 350.3658536585366 Td
(     572         09 00225            QTEXTC ' '     )Tj ET
BT
12.0 336.2195121951219 Td
(     573         09 00226            QTEXTC '   !pattern matches if pattern does not'     )Tj ET
BT
12.0 322.0731707317073 Td
(     574         09 00230            QTEXTC ' '     )Tj ET
BT
12.0 307.9268292682927 Td
(     575         09 00231            QTEXTC 'e.g.'     )Tj ET
BT
12.0 293.780487804878 Td
(     576         09 00233            QTEXTC ' LA * lists all files in the current account'     )Tj ET
BT
12.0 279.6341463414634 Td
(     577         09 0023F            QTEXTC ' LA *.* lists all files on the system'     )Tj ET
BT
12.0 265.4878048780488 Td
(     578                             QTEXTC ' LA J:*+ lists all files beginning with J:\,'\,;     )Tj ET
BT
12.0 251.34146341463412 Td
(     579         09 00249                   ' and ending with a digit'     )Tj ET
BT
12.0 237.1951219512195 Td
(     580         09 0025A            QTEXTC ' LA ABC.9* lists files named ABC in accounts beginning with 9'     )Tj ET
BT
12.0 223.0487804878049 Td
(     581         09 0026A            QTEXTC ' LA \\* lists the file "*"'     )Tj ET
BT
12.0 208.90243902439022 Td
(     582         09 00271            QTEXTC ' LA !A* lists files that do not begin with A'     )Tj ET
BT
12.0 194.7560975609756 Td
(     583         09 0027D            QTEXTC ' '     )Tj ET
BT
12.0 180.609756097561 Td
(     584         09 0027E            QTEXTC ' Selection options are separated by commas. Except for simple'     )Tj ET
BT
12.0 166.46341463414632 Td
(     585         09 0028E            QTEXTC ' boolean options and arguments can be specified as a list\, '     )Tj ET
BT
12.0 152.3170731707317 Td
(     586         09 0029D            QTEXTC ' e.g:'     )Tj ET
BT
12.0 138.1707317073171 Td
(     587         09 0029F            QTEXTC '   \(ORG\,''K''\,''C''\)'     )Tj ET
BT
12.0 124.02439024390242 Td
(     588         09 002A4            QTEXTC ' Dates and integers can use comparators rather than the comma:'     )Tj ET
BT
12.0 109.8780487804878 Td
(     589         09 002B4            QTEXTC '   ACCESSED<29FEB96'     )Tj ET
BT
12.0 95.73170731707319 Td
(     590         09 002B9            QTEXTC '   \(CREATED>01JAN97<31DEC97\)'     )Tj ET
BT
12.0 81.58536585365857 Td
(     591         09 002C1            QTEXTC '   \(GRAN<5>10\)'     )Tj ET
BT
12.0 67.43902439024384 Td
(     592         09 002C5            QTEXTC ' '     )Tj ET
BT
12.0 53.29268292682923 Td
(     593         09 002C6            QTEXTC ' Dates can take various forms including: DDMMMYY\, YYYY-MM-DD.'     )Tj ET
BT
12.0 39.146341463414615 Td
(     594         09 002D6            QTEXTC '   The form JD-n or JD+n express dates relative to the current'     )Tj ET
endstream
